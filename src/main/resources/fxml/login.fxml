<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ayoub.lockBox.controllers.LoginController"
      styleClass="login-container"
      alignment="CENTER"
      spacing="20">

    <!-- Lock Icon -->
    <StackPane>
        <Circle radius="50" styleClass="icon-circle"/>
        <ImageView fitWidth="60" fitHeight="60" preserveRatio="true">
            <Image url="@/icons/lock.png"/>
        </ImageView>
    </StackPane>

    <!-- App Title -->
    <VBox alignment="CENTER" spacing="5">
        <Label text="LOCKBOX" styleClass="app-title"/>
        <Label text="Password Manager" styleClass="app-subtitle"/>
    </VBox>

    <VBox.margin>
        <Insets top="60"/>
    </VBox.margin>

    <!-- Input Section -->
    <VBox alignment="CENTER" spacing="12" maxWidth="300">
        <Label text="Master Password" styleClass="input-label"/>
        <PasswordField fx:id="passwordField" promptText="Enter your master password" styleClass="password-input" onAction="#handleUnlock"/>

        <!-- Error Message (initially hidden) -->
        <Label fx:id="errorLabel" text="✕  Incorrect password. Try again." styleClass="error-message" visible="false" managed="false"/>

        <VBox.margin>
            <Insets top="20"/>
        </VBox.margin>
    </VBox>


    <!-- Unlock Button -->
    <HBox alignment="CENTER">
        <Button fx:id="unlockButton" styleClass="btn-primary" onAction="#handleUnlock" defaultButton="true" maxWidth="300" minWidth="300" minHeight="42">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                        <Image url="@/icons/unlock.png"/>
                    </ImageView>
                    <Label text="Unlock"/>
                </HBox>
            </graphic>
        </Button>
    </HBox>

    <!-- First Launch Info Box (initially hidden) -->
    <VBox fx:id="firstLaunchBox" alignment="CENTER" spacing="8" styleClass="first-launch-box" maxWidth="340" visible="false" managed="false">
        <Label text="First Launch?" styleClass="first-launch-title"/>
        <Label text="Create your master password here." styleClass="first-launch-text"/>
        <Label text="A confirm field will appear." styleClass="first-launch-text"/>

        <!-- Confirm Password Field (only for first launch) -->
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm master password" styleClass="password-input" visible="false" managed="false"/>

        <VBox.margin>
            <Insets top="20"/>
        </VBox.margin>
    </VBox>

</VBox>